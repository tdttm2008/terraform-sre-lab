# Local provider/module cache
**/.terraform/*

# State files can contain secrets in plain text — never commit
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files usually hold real values; commit *.tfvars.example instead
*.tfvars
*.tfvars.json
!*.tfvars.example

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Saved plans can contain sensitive values
*.tfplan
tfplan

# CLI config / credentials
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally NOT ignored — commit it to pin provider versions.
